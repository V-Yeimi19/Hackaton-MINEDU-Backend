# Usado por docker-compose.yml

# Postgres
POSTGRES_USER=minedu
POSTGRES_PASSWORD=minedu

# MinIO
MINIO_ROOT_USER=minedu
MINIO_ROOT_PASSWORD=minedu123
MINIO_BUCKET=minedu-files
# Host que usa Storage para generar URLs prefirmadas de descarga. Por defecto
# "minio" (hostname interno de Docker) solo es alcanzable dentro de la red del
# compose. Si necesitas que las descargas funcionen desde fuera (ej. un VPS
# expuesto públicamente), pon aquí la IP pública o dominio del servidor.
MINIO_ENDPOINT=minio

# Auth / JWT (compartido entre auth, users, storage, notifications y gateway)
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=86400

# Comunicación interna entre servicios (Auth -> Users, otros -> Notifications)
INTERNAL_API_KEY=dev-internal-key

# Gateway
RATE_LIMIT_MAX=100
