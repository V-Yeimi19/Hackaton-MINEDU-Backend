# Usado por docker-compose.yml

# Postgres
POSTGRES_USER=minedu
POSTGRES_PASSWORD=minedu

# MinIO
MINIO_ROOT_USER=minedu
MINIO_ROOT_PASSWORD=minedu123
MINIO_BUCKET=minedu-files

# Auth / JWT (compartido entre auth, users, storage, notifications y gateway)
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=86400

# Comunicación interna entre servicios (Auth -> Users, otros -> Notifications)
INTERNAL_API_KEY=dev-internal-key

# Gateway
RATE_LIMIT_MAX=100
