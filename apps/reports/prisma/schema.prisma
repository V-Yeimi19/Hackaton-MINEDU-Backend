generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model InstitutionReport {
  id                String   @id @default(uuid())
  gradeLevel        String?
  courseId          String?
  periodStart       DateTime
  periodEnd         DateTime
  classroomCount    Int
  studentCount      Int
  avgAttendanceRate Float
  avgGrade          Float
  riskCounts        Json
  fileId            String?
  pdfFileId         String?   // PDF report, added 2026-07-25
  generatedBy       String
  createdAt         DateTime @default(now())

  @@index([gradeLevel])
  @@index([courseId])
}
