{
  "name": "tokenizados-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Hackaton MINEDU Backend - monorepo de microservicios NestJS",
  "scripts": {
    "dev:gateway": "pnpm --filter gateway start:dev",
    "dev:auth": "pnpm --filter auth start:dev",
    "dev:users": "pnpm --filter users start:dev",
    "dev:classroom": "pnpm --filter classroom start:dev",
    "dev:analytics": "pnpm --filter analytics start:dev",
    "dev:ai": "pnpm --filter ai start:dev",
    "dev:accessibility": "pnpm --filter accessibility start:dev",
    "build": "pnpm -r build",
    "test": "jest --config jest.config.ts",
    "test:integration": "jest --config jest.config.ts --testPathPattern=integration",
    "test:e2e": "jest --config jest.config.ts --testPathPattern=e2e",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
